<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="C:\Users\Administrator\Desktop\multi-carla-master-8.22-CARLATOSUMO\src\macad_gym\carla\sumo_NGSIM\1.net.xml"/>
        <route-files value="C:\Users\Administrator\Desktop\multi-carla-master-8.22-CARLATOSUMO\src\macad_gym\carla\sumo_NGSIM\official_trajectory.rou.xml"/>
    </input>
    
    <processing>
        <lateral-resolution value="0.64"/>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
        <collision.mingap-factor value="0"/>
        <step-method.ballistic value="true"/>
